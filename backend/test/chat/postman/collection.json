      ]
    },
    {
      "name": "Invalid SSE input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/chat_stream",
        "body": {
          "mode": "raw",
          "raw": "{\"Id\": \"postman-a\", \"Question\": \" \"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"validation remains HTTP JSON\",()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().message).to.eql(\"invalid request\");pm.expect(pm.response.text()).not.to.include(\"event:\");});"
            ]
          }
        }
      ]
    }
  ]
}
