      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b=pm.response.json();",
              "pm.test(\"report envelope\",()=>{pm.response.to.have.status(200);pm.expect(b.message).to.eql(\"OK\");pm.expect(b.data.result).to.be.a(\"string\").and.not.empty;pm.expect(b.data.detail).to.be.an(\"array\");});",
              "pm.test(\"typed empty alerts\",()=>{const e=b.data.detail.filter(e=>e.tool===\"query_prometheus_alerts\").at(-1);pm.expect(e.status).to.eql(\"completed\");pm.expect(e.count).to.eql(0);});"
            ]
          }
        }
      ]
    },
