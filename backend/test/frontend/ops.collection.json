              "const frames=pm.response.text().split(\"\\n\\n\").filter(s=>s.startsWith(\"event: \")).map(s=>({name:s.split(\"\\n\")[0].slice(7),data:JSON.parse(s.split(\"\\ndata: \")[1])}));",
              "const progress=frames.filter(f=>f.name===\"progress\").map(f=>f.data);const terminal=frames.at(-1);",
              "pm.test(\"ordered structured progress\",()=>{pm.expect(frames[0].name).to.eql(\"connected\");pm.expect(progress.length).to.be.above(0);progress.forEach((e,i)=>pm.expect(e.sequence).to.eql(i+1));const starts=new Map();for(const e of progress){if(!e.stepId)continue;if(e.status===\"started\"){pm.expect(starts.has(e.stepId)).to.eql(false);starts.set(e.stepId,e);}else{pm.expect(starts.has(e.stepId)).to.eql(true);pm.expect(e.durationMs).to.be.at.least(0);pm.expect(e.title).to.eql(starts.get(e.stepId).title);}}});",
              "pm.test(\"typed SSE failure\",()=>{pm.expect(terminal.name).to.eql(\"error\");pm.expect(terminal.data.data.code).to.eql(\"timeout\");pm.expect(terminal.data.data.detail).to.deep.eql(progress);pm.expect(pm.response.text()).not.to.include(\"fixture-private-secret\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reset normal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{helper_url}}/__test/ops-scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"scenario\":\"normal\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"reset\",()=>{pm.response.to.have.status(200);});"
            ]
          }
        }
      ]
    }
  ]
}
