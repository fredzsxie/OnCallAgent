          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"safe execution_failed\",()=>{pm.response.to.have.status(502);const b=pm.response.json();pm.expect(b.data.code).to.eql(\"execution_failed\");pm.expect(b.data.detail).to.be.an(\"array\");pm.expect(b.data).not.to.have.property(\"result\");pm.expect(pm.response.text()).not.to.include(\"fixture-private-secret\");});"
            ]
          }
        }
      ]
    },
