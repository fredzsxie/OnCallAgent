{
  "info": {
    "name": "OnCallAgent AI Ops HTTP acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "helper_url",
      "value": "http://127.0.0.1:6872"
    }
  ],
  "item": [
    {
      "name": "Select normal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{helper_url}}/__test/ops-scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"scenario\": \"normal\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"scenario selected\",()=>{pm.response.to.have.status(200);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Analyze normal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/ai_ops",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b=pm.response.json();",
              "pm.test(\"report envelope\",()=>{pm.response.to.have.status(200);pm.expect(b.message).to.eql(\"OK\");pm.expect(b.data.result).to.be.a(\"string\").and.not.empty;pm.expect(b.data.detail).to.be.an(\"array\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Select empty",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{helper_url}}/__test/ops-scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"scenario\": \"empty\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"scenario selected\",()=>{pm.response.to.have.status(200);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Analyze empty",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/ai_ops",
