# Loaded automatically at startup; existing process variables take precedence.
ONCALL_SERVER_PORT=6872
ONCALL_CHAT_MODEL_BASE_URL=https://your-provider.example/v1
ONCALL_CHAT_MODEL_MODEL=your-actual-model-id
ONCALL_CHAT_MODEL_API_KEY=
ONCALL_CHAT_MODEL_TIMEOUT=30s

ONCALL_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ONCALL_EMBEDDING_MODEL=doubao-embedding-vision-251215
# Use ARK_API_KEY, or ONCALL_EMBEDDING_API_KEY to override it explicitly.
ARK_API_KEY=
ONCALL_EMBEDDING_TIMEOUT=30s

ONCALL_MILVUS_ADDRESS=localhost:19530
ONCALL_MILVUS_DATABASE=default
ONCALL_MILVUS_COLLECTION=oncall_knowledge
ONCALL_MILVUS_TLS=false
ONCALL_MILVUS_CONNECT_TIMEOUT=5s
ONCALL_MILVUS_TIMEOUT=60s
# Optional authentication: set both values, or omit both.
# ONCALL_MILVUS_USERNAME=
# ONCALL_MILVUS_PASSWORD=

ONCALL_FILE_DIR=./data/knowledge
ONCALL_UPLOAD_MAX_BYTES=10485760
# Chunk size and overlap count UTF-8 bytes, not characters or tokens.
ONCALL_KNOWLEDGE_CHUNK_SIZE=2000
ONCALL_KNOWLEDGE_CHUNK_OVERLAP=200
ONCALL_KNOWLEDGE_BATCH_SIZE=16

ONCALL_RETRIEVAL_TOP_K=3
ONCALL_RETRIEVAL_SCORE_THRESHOLD=0.5
ONCALL_TOOLS_QUERY_INTERNAL_DOCS_ENABLED=true
ONCALL_TOOLS_GET_CURRENT_TIME_ENABLED=true
ONCALL_TIME_ZONE=Asia/Shanghai

ONCALL_CHAT_AGENT_MAX_STEPS=12
ONCALL_CHAT_AGENT_TIMEOUT=60s

ONCALL_CHAT_MEMORY_MAX_ROUNDS=3
ONCALL_CHAT_MEMORY_TTL=30m

# Optional operations tools. Clients are created only for enabled/selected tools.
ONCALL_TOOLS_QUERY_PROMETHEUS_ALERTS_ENABLED=false
ONCALL_PROMETHEUS_BASE_URL=http://127.0.0.1:9090
ONCALL_PROMETHEUS_TIMEOUT=15s
ONCALL_PROMETHEUS_AUTH_TYPE=none
ONCALL_PROMETHEUS_USERNAME=
ONCALL_PROMETHEUS_PASSWORD=
ONCALL_PROMETHEUS_BEARER_TOKEN=

ONCALL_TOOLS_QUERY_LOG_ENABLED=false
# Supply an actual CLS Streamable HTTP /mcp URL before enabling.
ONCALL_LOG_MCP_URL=
ONCALL_LOG_MCP_TIMEOUT=15s
ONCALL_LOG_MCP_AUTH_TYPE=none
ONCALL_LOG_MCP_USERNAME=
ONCALL_LOG_MCP_PASSWORD=
ONCALL_LOG_MCP_BEARER_TOKEN=
ONCALL_LOG_MCP_HEADER_NAME=
ONCALL_LOG_MCP_HEADER_VALUE=
ONCALL_LOG_REGION=
ONCALL_LOG_TOPIC_ID=
ONCALL_LOG_LOOKBACK=15m
ONCALL_LOG_LIMIT=20
